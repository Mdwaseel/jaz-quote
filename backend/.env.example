# ---------------------------------------------------------------------------
# JAZ Home Theatres quotation backend — environment. Copy to `.env` on the
# server and edit. Loaded automatically by brio/settings.py at startup.
# ---------------------------------------------------------------------------

# Django core --------------------------------------------------------------
# Generate a fresh one for every deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE-ME-generate-with-the-command-above
DEBUG=false
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Auth token encryption (Fernet) ------------------------------------------
# Generate a fresh one for every deployment:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=CHANGE-ME-generate-with-the-command-above

# Database (PostgreSQL on the VPS) ----------------------------------------
DB_ENGINE=postgres
DB_NAME=jaz
DB_USER=jaz
DB_PASSWORD=change-this-strong-password
DB_HOST=127.0.0.1
DB_PORT=5432

# First admin login (created once by `manage.py seed`) ---------------------
# Login OTP codes are emailed to this address, so use a mailbox you can read.
SEED_ADMIN_EMAIL=you@your-domain.com
SEED_ADMIN_PASSWORD=change-this-on-first-login

# Email: login OTP, password reset, approvals, customer e-signature --------
# For Gmail / Google Workspace use an App Password (16 characters, no spaces).
OTP_ENABLED=true
OTP_TTL_MINUTES=5
# Public URL of the app — used for links in emails (password reset, e-sign).
SITE_URL=https://your-domain.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=you@your-domain.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=JAZ Home Theatres <you@your-domain.com>

# CORS (leave empty when frontend is served same-origin behind Nginx) ------
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=

# HTTPS redirect (set false if TLS is terminated elsewhere) ----------------
SECURE_SSL_REDIRECT=true
