# Normalise line endings in the repo; checkouts use the platform default...
* text=auto

# ...except files executed or parsed inside Linux containers / the VPS, which must
# always be LF (a CRLF shebang makes the container fail with "no such file or directory").
*.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.env* text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.ico binary
*.woff binary
*.woff2 binary
